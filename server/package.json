{
  "name": "server",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env --import tsx src/index.ts",
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "make-big-log": "node --env-file=.env --import tsx scripts/make-big-log.ts",
    "replay": "node --env-file=.env --import tsx scripts/replay.ts",
    "loadtest": "node --import tsx scripts/loadtest.ts",
    "load-chart": "node --import tsx scripts/load-chart.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:ws --external:zod --external:pino --outfile=dist/index.js",
    "start:prod": "node dist/index.js",
    "chaos": "node --import tsx scripts/chaos.ts"
  },
  "dependencies": {
    "pino": "^9.7.0",
    "shared": "*",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0"
  }
}
