# Змінні оточення сервера (на хостингу задаються в його налаштуваннях, не в git)
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# звідки можна відкривати WebSocket (через кому); сторінка з того самого сервера дозволена завжди
ALLOWED_ORIGINS=https://space-duel.onrender.com
MAX_CONN_PER_IP=10
# 1 - сервер за проксі хостингу, IP клієнта брати з X-Forwarded-For
TRUST_PROXY=1
MAX_ROOMS=20
MAX_PLAYERS=8
STATIC_DIR=../client/dist
LOG_DIR=./logs
